{
  "dashboard": {
    "id": null,
    "title": "HyperRAG System Overview",
    "tags": ["hyperrag", "overview"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Service Health",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=~\"hyperrag-.*\"}",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Request Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(hyperrag_ingestion_total[5m])",
            "legendFormat": "Ingestion - {{tenant}}"
          },
          {
            "expr": "rate(hyperrag_retrieval_total[5m])",
            "legendFormat": "Retrieval - {{tenant}}"
          },
          {
            "expr": "rate(hyperrag_agent_sessions_total[5m])",
            "legendFormat": "Agent Sessions - {{tenant}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Response Time (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(hyperrag_ingestion_duration_seconds_bucket[5m]))",
            "legendFormat": "Ingestion p95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(hyperrag_retrieval_duration_seconds_bucket[5m]))",
            "legendFormat": "Retrieval p95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(hyperrag_agent_duration_seconds_bucket[5m]))",
            "legendFormat": "Agent p95"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(hyperrag_ingestion_total{status=\"error\"}[5m]) / rate(hyperrag_ingestion_total[5m])",
            "legendFormat": "Ingestion Error Rate"
          },
          {
            "expr": "rate(hyperrag_retrieval_total{status=\"error\"}[5m]) / rate(hyperrag_retrieval_total[5m])",
            "legendFormat": "Retrieval Error Rate"
          },
          {
            "expr": "rate(hyperrag_agent_sessions_total{status=\"failed\"}[5m]) / rate(hyperrag_agent_sessions_total[5m])",
            "legendFormat": "Agent Error Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
